# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_INITIAL_PASSWORD: Optional initial administrator password for server-side bootstrap.
ADMIN_INITIAL_PASSWORD="CHANGE_ME_INITIAL_ADMIN_PASSWORD"

# CONTACT_RECIPIENT_EMAIL: Optional (defaults to jaimangoldenlitetechltd@gmail.com).
CONTACT_RECIPIENT_EMAIL="jaimangoldenlitetechltd@gmail.com"

# Optional Email Delivery Configuration (only needed for automatic SMTP/Resend forwarding; enquiries are always saved in Admin Dashboard)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# Optional Supabase Configuration (only needed if switching database from Cloud SQL to Supabase)
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
